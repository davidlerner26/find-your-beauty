# Parameters of the test environment (firebase deploy --project dev). No secrets here: the Resend key is a secret of
# the project (firebase functions:secrets:set RESEND_API_KEY --project dev).
APP_URL=https://dev.findyourbeauty.com.br
ENV_NAME=dev
INSTAGRAM_APP_ID=1138530759119798
# Payments with Stripe exist only here. The secret key is a secret of the project:
# firebase functions:secrets:set STRIPE_SECRET_KEY --project dev
PAYMENTS=on
# The Pro subscription of the professionals (docs/assinatura-pro.md). The webhook secret is a secret of the project:
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project dev
SUBSCRIPTIONS=on
# The recurring Price (price_...) created in the Stripe dashboard in test mode
PRO_PRICE_ID=
