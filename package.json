{
  "name": "find-your-beauty",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:en": "ng serve --configuration en",
    "start:es": "ng serve --configuration es",
    "i18n": "ng extract-i18n",
    "start:prod": "ng serve --configuration production",
    "build:dev": "ng build --configuration dev && node scripts/robots-dev.cjs",
    "deploy:dev": "firebase deploy --project dev",
    "deploy:prod": "firebase deploy --project default",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-find-your-beauty \"vitest run --config vitest.rules.config.ts rules-tests\"",
    "test:functions": "firebase emulators:exec --only firestore --project demo-find-your-beauty \"vitest run --config vitest.rules.config.ts functions/tests\"",
    "e2e": "node scripts/e2e.cjs",
    "e2e:ui": "node scripts/e2e.cjs --ui",
    "sync:shared": "node scripts/sync-shared.cjs",
    "check:shared": "node scripts/sync-shared.cjs --check",
    "storybook": "ng run find-your-beauty:storybook",
    "build-storybook": "ng run find-your-beauty:build-storybook",
    "test:storybook": "playwright test -c playwright.storybook.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/google-maps": "^22.2.4",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@ngrx/signals": "^21.1.1",
    "@stripe/stripe-js": "^10.2.0",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular/animations": "^22.2.3",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/angular-vite": "^10.6.4",
    "@types/node": "^20",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.4",
    "firebase-admin": "^14.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.0.8"
  }
}
