rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins approve new professionals. An admin has `admin: true` in their users document, which can
    // only be set by hand in the Firestore console (the rules below stop anyone from changing it).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Public catalog. A professional account owns the document with its own uid as id.
    match /professionals/{id} {
      allow read: if true;
      // New accounts start waiting for approval
      allow create: if request.auth != null && request.auth.uid == id && request.resource.data.approved == false &&
        request.resource.data.get('admin', false) == false;
      // The owner edits the profile but can't change the approval; admins can change anything
      // (a denied sign up can be sent again: the owner may only turn `rejected` from true to false)
      allow update: if (request.auth != null && request.auth.uid == id &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'admin']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rejected']) ||
          (resource.data.get('rejected', false) == true && request.resource.data.rejected == false))) || isAdmin();

      // One review per client, only after a booking with this professional was completed
      match /reviews/{clientUid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == clientUid &&
          request.resource.data.clientUid == clientUid &&
          request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5 &&
          request.resource.data.text is string && request.resource.data.text.size() <= 500 &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientUid == clientUid &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.professionalId == id &&
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed';
        allow delete: if request.auth != null && request.auth.uid == clientUid;
      }

      // The CPF of the professional: only the owner and the admins read it (the rest of `private` stays closed)
      match /private/identity {
        allow read, write: if request.auth != null && request.auth.uid == id;
        allow read: if isAdmin();
      }

      // One document per taken slot. It can only be created once, which prevents double bookings.
      // The slot must belong to a booking created in the same batch (getAfter), so nobody can block
      // the calendar of a professional without actually booking.
      match /busy/{slot} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['date', 'clientUid', 'bookingId']) &&
          request.resource.data.clientUid == request.auth.uid &&
          slot.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}$') &&
          request.resource.data.date == slot.split('_')[0] &&
          request.resource.data.bookingId is string &&
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.clientUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.professionalId == id &&
          slot in getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.busyIds;
        // The professional frees a slot, or the client who took it (when cancelling)
        allow delete: if request.auth != null && (request.auth.uid == id || resource.data.clientUid == request.auth.uid);
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // `admin` is informational (the real list is isAdmin() above): nobody can give it to themselves
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('admin', false) == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('admin', false) == resource.data.get('admin', false);
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Professionals the client hearted
      match /favorites/{professionalId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Notifications are created by Cloud Functions. The owner can only mark them as read.
      match /notifications/{n} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread']);
      }
    }

    match /bookings/{id} {
      allow read: if request.auth != null &&
        (resource.data.clientUid == request.auth.uid || resource.data.professionalUid == request.auth.uid);
      // A booking is for an existing, approved professional, and its shape and sizes are checked here.
      // (Prices can't be recomputed in the rules: the total is only bounded.)
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['clientUid', 'clientName', 'professionalId', 'professionalUid',
          'professionalName', 'services', 'startsAt', 'durationMinutes', 'total', 'notes', 'busyIds', 'status',
          'place', 'clientAddress', 'lang', 'paymentStatus', 'paymentIntentId', 'createdAt']) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() <= 200 &&
        request.resource.data.professionalName is string && request.resource.data.professionalName.size() <= 200 &&
        request.resource.data.notes is string && request.resource.data.notes.size() <= 1000 &&
        request.resource.data.get('paymentIntentId', 'none') is string &&
        request.resource.data.get('paymentIntentId', 'none').size() <= 100 &&
        request.resource.data.get('clientAddress', '') is string &&
        request.resource.data.get('clientAddress', '').size() <= 500 &&
        request.resource.data.get('place', 'studio') in ['home', 'studio'] &&
        request.resource.data.get('lang', 'pt') in ['pt', 'en', 'es'] &&
        request.resource.data.startsAt is timestamp && request.resource.data.startsAt > request.time &&
        request.resource.data.durationMinutes is int && request.resource.data.durationMinutes > 0 &&
        request.resource.data.durationMinutes <= 1440 &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.total <= 100000 &&
        request.resource.data.services is list && request.resource.data.services.size() >= 1 &&
        request.resource.data.services.size() <= 20 &&
        request.resource.data.busyIds is list && request.resource.data.busyIds.size() >= 1 &&
        request.resource.data.busyIds.size() <= 96 &&
        exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)) &&
        get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.get('approved', true) == true &&
        request.resource.data.professionalUid ==
          get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.get('ownerUid', null) &&
        request.resource.data.professionalUid != request.auth.uid;
      allow update: if request.auth != null && resource.data.professionalUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      // The client can only cancel their own booking
      allow update: if request.auth != null && resource.data.clientUid == request.auth.uid &&
        resource.data.status in ['pending', 'confirmed'] && request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Conversation ids are {clientUid}_{professionalId}. Demo professionals have no account, so their
    // conversations only have the client as participant.
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && id.split('_')[0] == request.auth.uid &&
        request.resource.data.keys().hasOnly(['participants', 'clientUid', 'clientName', 'clientImage',
          'professionalId', 'lastMessage', 'lastMessageAt', 'unreadProfessional', 'unreadClient']) &&
        request.resource.data.clientUid == request.auth.uid &&
        id == request.auth.uid + '_' + request.resource.data.professionalId &&
        request.resource.data.participants is list &&
        request.resource.data.participants[0] == request.auth.uid &&
        (request.resource.data.participants.size() == 1 ||
          (request.resource.data.participants.size() == 2 &&
            request.resource.data.participants[1] ==
              get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.get('ownerUid', null))) &&
        request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 5000;
      // Only the preview and the unread counters (and the client's display data) change
      allow update: if request.auth != null && request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt',
          'unreadProfessional', 'unreadClient', 'clientName', 'clientImage']) &&
        request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 5000;

      match /messages/{m} {
        allow read: if request.auth != null && (id.split('_')[0] == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants);
        allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['senderUid', 'text', 'image', 'file', 'createdAt']) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 5000 &&
          request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() <= 2048 &&
          (!('file' in request.resource.data) ||
            (request.resource.data.file is map && request.resource.data.file.keys().hasOnly(['url', 'name']) &&
              request.resource.data.file.url is string && request.resource.data.file.url.size() <= 2048 &&
              request.resource.data.file.name is string && request.resource.data.file.name.size() <= 255)) &&
          (id.split('_')[0] == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants);
      }
    }
  }
}
