rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // An admin has `admin: true` in their users document (the same list as firestore.rules)
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Photos of a professional. Anyone can see them, only the owner uploads (images up to 5 MB).
    match /professionals/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photos of a profile an admin is making for someone who has no account yet (see professionalDrafts in
    // firestore.rules). Only admins. The photos are copied to professionals/{uid} when the profile is claimed.
    match /professionalDrafts/{draftId}/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Files of a conversation: only its two participants (up to 10 MB). Its id is {clientUid}_{professionalId}.
    // Only photos and common documents: no scripts, executables or web pages.
    match /chats/{conversationId}/{allPaths=**} {
      allow read: if request.auth != null && (conversationId.split('_')[0] == request.auth.uid ||
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants);
      allow create: if request.auth != null && request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'text/plain' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.ms-excel' ||
          request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')) &&
        (conversationId.split('_')[0] == request.auth.uid ||
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants);
    }
  }
}
